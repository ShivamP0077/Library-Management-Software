# Frontend (Vite) env. Set these in Vercel project settings.
# Backend origin, e.g. https://lms-api.onrender.com  (leave empty in local dev to use the Vite proxy -> localhost:4000)
VITE_API_URL=
# Google sign-in is configured on the backend (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET /
# GOOGLE_CALLBACK_URL / FRONTEND_URL); no frontend Google client ID is needed.
# Shown in Contact Us, Help & Support, and the plan lock screen.
VITE_SUPPORT_EMAIL=mylibraryosadmin@gmail.com
# Optional. Leave unset to hide the phone and WhatsApp rows (do not show a placeholder).
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_WHATSAPP=
