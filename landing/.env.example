# URL of the deployed app (Vercel frontend). "Start free trial" / "Sign in" link here.
VITE_APP_URL=/app
# Address used by the "Book a demo" mailto link and the footer.
VITE_DEMO_EMAIL=mylibraryosadmin@gmail.com
# Absolute public URL of this landing page, used for canonical + OG tags at build time.
# If unset, the build falls back to https://mylibraryos.in so the tags are never empty.
VITE_SITE_URL=https://mylibraryos.in
