# Copy to .env and fill in. Never commit .env.
# MongoDB: a mongodb+srv:// Atlas URI (credentials may be omitted; injected from the two vars below) or any mongodb:// URI
MONGODB_URI=mongodb+srv://cluster0.xxxxx.mongodb.net
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=library_management
PORT=4000
NODE_ENV=production
# Long random string used to sign app JWTs (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated allowed frontend origins, e.g. https://your-app.vercel.app,http://localhost:3003
CORS_ORIGIN=http://localhost:3003,http://localhost:3001,http://localhost:5173
# Super admin (seeded on startup if missing). Use the Google account email that should own the platform.
SUPERADMIN_EMAIL=your-email@example.com
# Optional password-login fallback for the super admin. If empty and SUPERADMIN_CREDENTIALS_FILE is set,
# a strong password is generated and written there (0600). If both are empty, the account is Google-only.
SUPERADMIN_PASSWORD=
SUPERADMIN_CREDENTIALS_FILE=
# Google OAuth 2.0 (server-side authorization-code flow). Create an OAuth 2.0 Web client in Google Cloud Console.
# The client secret stays on the server; never commit it or expose it to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a registered redirect URI.
# Production: https://lms-api-sz2z.onrender.com/api/auth/google/callback
# Local: http://localhost:5000/api/auth/google/callback (run the API with PORT=5000 because that is the
# registered local redirect URI, and point Vite at it with VITE_DEV_API_PROXY=http://localhost:5000).
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Frontend used for post-sign-in redirects. Production: https://library-os-app.vercel.app
FRONTEND_URL=http://localhost:3001
# Demo seed (npm run seed:demo)
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_CREDENTIALS_FILE=

# WhatsApp via Evolution API (server-side only; never expose to the frontend)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
